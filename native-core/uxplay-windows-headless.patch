+void MainWindow::startCommandReader() {
+    m_commandReader = std::thread([]() {
+        const std::regex discoveryCommand(
+            "^AEROMIRROR_COMMAND refresh-discovery request=([1-9][0-9]{0,19})$");
+        const std::regex fullscreenCommand(
+            "^AEROMIRROR_COMMAND video-fullscreen-set state=([01])$");
+        const std::regex scaleCommand(
+            "^AEROMIRROR_COMMAND video-scale permille=([1-9][0-9]{3})$");
+        HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+        if (input == NULL || input == INVALID_HANDLE_VALUE) return;
+        std::string pending;
+        char chunk[128];
+        DWORD count = 0;
+        while (ReadFile(input, chunk, sizeof(chunk), &count, NULL) && count) {
+            pending.append(chunk, count);
+            if (pending.size() > 1024) {
+                pending.clear();
+                fprintf(stderr,
+                        "AEROMIRROR_COMMAND_REJECTED reason=overflow\n");
+                fflush(stderr);
+                continue;
+            }
+            std::size_t newline = 0;
+            while ((newline = pending.find('\n')) != std::string::npos) {
+                std::string line = pending.substr(0, newline);
+                pending.erase(0, newline + 1);
+                if (!line.empty() && line.back() == '\r') line.pop_back();
+                if (line.size() > 256) {
+                    fprintf(stderr,
+                            "AEROMIRROR_COMMAND_REJECTED reason=overflow\n");
+                    fflush(stderr);
+                    continue;
+                }
+                std::smatch match;
+
+                if (std::regex_match(line, match, fullscreenCommand)) {
+                    const int state = match[1].str() == "1" ? 1 : 0;
+                    if (!request_video_fullscreen_set(state)) {
+                        fprintf(stderr,
+                                "AEROMIRROR_COMMAND_REJECTED "
+                                "command=video-fullscreen-set state=%d "
+                                "reason=busy-or-not-ready\n",
+                                state);
+                        fflush(stderr);
+                    }
+                    continue;
+                }
+
+                if (std::regex_match(line, match, scaleCommand)) {
+                    unsigned long scale = 0;
+                    try {
+                        scale = std::stoul(match[1].str());
+                    } catch (...) {
+                        scale = 0;
+                    }
+                    if (!scale || scale > 0xffffffffUL ||
+                        !request_video_scale((unsigned int) scale)) {
+                        fprintf(stderr,
+                                "AEROMIRROR_COMMAND_REJECTED "
+                                "command=video-scale reason=%s\n",
+                                scale ? "busy-or-invalid" : "invalid");
+                        fflush(stderr);
+                    }
+                    continue;
+                }
+
+                unsigned long long request = 0;
+                try {
+                    if (std::regex_match(line, match, discoveryCommand)) {
+                        request = std::stoull(match[1].str());
+                    }
+                } catch (...) {
+                    request = 0;
+                }
+                if (!request || !request_discovery_refresh(request)) {
+                    fprintf(stderr,
+                            "AEROMIRROR_COMMAND_REJECTED request=%llu reason=%s\n",
+                            request,
+                            request ? "busy-or-not-ready" : "invalid");
+                    fflush(stderr);
+                }
+            }
+        }
