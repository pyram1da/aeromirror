+void MainWindow::startCommandReader() {
+    m_commandReader = std::thread([]() {
+        const auto secureClearString = [](std::string &value) {
+            if (!value.empty()) {
+                SecureZeroMemory(&value[0], value.size());
+                value.clear();
+            }
+        };
+        const std::regex discoveryCommand(
+            "^AEROMIRROR_COMMAND refresh-discovery request=([1-9][0-9]{0,19})$");
+        const std::regex fullscreenCommand(
+            "^AEROMIRROR_COMMAND video-fullscreen-set state=([01])$");
+        const std::regex sessionCloseCommand(
+            "^AEROMIRROR_COMMAND close-session session=([1-9][0-9]{0,19})$");
+        const std::regex scaleCommand(
+            "^AEROMIRROR_COMMAND video-scale permille=([1-9][0-9]{3})$");
+        const std::regex pairingPinCommand(
+            "^AEROMIRROR_SECRET pairing-pin request=([1-9][0-9]{0,19}) pin=([0-9]{4})$");
+        const std::regex pairingCancelCommand(
+            "^AEROMIRROR_COMMAND pairing-pin-cancel request=([1-9][0-9]{0,19})$");
+        HANDLE input = GetStdHandle(STD_INPUT_HANDLE);
+        if (input == NULL || input == INVALID_HANDLE_VALUE) return;
+        std::string pending;
+        char chunk[128];
+        DWORD count = 0;
+        while (ReadFile(input, chunk, sizeof(chunk), &count, NULL) && count) {
+            pending.append(chunk, count);
+            SecureZeroMemory(chunk, count);
+            if (pending.size() > 1024) {
+                secureClearString(pending);
+                fprintf(stderr,
+                        "AEROMIRROR_COMMAND_REJECTED reason=overflow\n");
+                fflush(stderr);
+                continue;
+            }
+            std::size_t newline = 0;
+            while ((newline = pending.find('\n')) != std::string::npos) {
+                std::string line = pending.substr(0, newline);
+                std::string remainder = pending.substr(newline + 1);
+                secureClearString(pending);
+                pending.swap(remainder);
+                if (!line.empty() && line.back() == '\r') line.pop_back();
+                if (line.size() > 256) {
+                    secureClearString(line);
+                    fprintf(stderr,
+                            "AEROMIRROR_COMMAND_REJECTED reason=overflow\n");
+                    fflush(stderr);
+                    continue;
+                }
+                std::smatch match;
+
+                if (std::regex_match(line, match, pairingPinCommand)) {
+                    unsigned long long request = 0;
+                    std::string pin = match[2].str();
+                    try {
+                        request = std::stoull(match[1].str());
+                    } catch (...) {
+                        request = 0;
+                    }
+                    const int accepted = request &&
+                        submit_pairing_pin(request, pin.c_str());
+                    if (!pin.empty()) {
+                        SecureZeroMemory(&pin[0], pin.size());
+                    }
+                    match = std::smatch();
+                    secureClearString(line);
+                    if (!accepted) {
+                        fprintf(stderr,
+                                "AEROMIRROR_PAIRING_SECRET_REJECTED "
+                                "request=%llu reason=stale-or-invalid\n",
+                                request);
+                        fflush(stderr);
+                    }
+                    continue;
+                }
+
+                if (std::regex_match(line, match, pairingCancelCommand)) {
+                    unsigned long long request = 0;
+                    try {
+                        request = std::stoull(match[1].str());
+                    } catch (...) {
+                        request = 0;
+                    }
+                    if (!request || !cancel_pairing_pin(request)) {
+                        fprintf(stderr,
+                                "AEROMIRROR_COMMAND_REJECTED "
+                                "command=pairing-pin-cancel request=%llu "
+                                "reason=stale-or-invalid\n",
+                                request);
+                        fflush(stderr);
+                    }
+                    continue;
+                }
+
+                if (std::regex_match(line, match, fullscreenCommand)) {
+                    const int state = match[1].str() == "1" ? 1 : 0;
+                    if (!request_video_fullscreen_set(state)) {
+                        fprintf(stderr,
+                                "AEROMIRROR_COMMAND_REJECTED "
+                                "command=video-fullscreen-set state=%d "
+                                "reason=busy-or-not-ready\n",
+                                state);
+                        fflush(stderr);
+                    }
+                    continue;
+                }
+
+                if (std::regex_match(line, match, sessionCloseCommand)) {
+                    unsigned long long session = 0;
+                    try { session = std::stoull(match[1].str()); }
+                    catch (...) { session = 0; }
+                    if (!session || !request_video_session_close(session)) {
+                        fprintf(stderr,
+                            "AEROMIRROR_COMMAND_REJECTED command=close-session "
+                            "session=%llu reason=unavailable-or-invalid\n", session);
+                        fflush(stderr);
+                    }
+                    continue;
+                }
+
+                if (std::regex_match(line, match, scaleCommand)) {
+                    unsigned long scale = 0;
+                    try {
+                        scale = std::stoul(match[1].str());
+                    } catch (...) {
+                        scale = 0;
+                    }
+                    if (!scale || scale > 0xffffffffUL ||
+                        !request_video_scale((unsigned int) scale)) {
+                        fprintf(stderr,
+                                "AEROMIRROR_COMMAND_REJECTED "
+                                "command=video-scale reason=%s\n",
+                                scale ? "busy-or-invalid" : "invalid");
+                        fflush(stderr);
+                    }
+                    continue;
+                }
+
+                unsigned long long request = 0;
+                try {
+                    if (std::regex_match(line, match, discoveryCommand)) {
+                        request = std::stoull(match[1].str());
+                    }
+                } catch (...) {
+                    request = 0;
+                }
+                if (!request || !request_discovery_refresh(request)) {
+                    fprintf(stderr,
+                            "AEROMIRROR_COMMAND_REJECTED request=%llu reason=%s\n",
+                            request,
+                            request ? "busy-or-not-ready" : "invalid");
+                    fflush(stderr);
+                }
+            }
+        }
+        secureClearString(pending);
+    });
+    m_commandReader.detach();
 }
 
