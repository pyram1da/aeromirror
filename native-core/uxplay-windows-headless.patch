+void RendererHostWindow::applyFullscreenState(
+        bool desired,
+        const char *source) {
+    ++m_fullscreenGeneration;
+    const bool before = isFullScreen();
+    if (desired && !isVisible()) {
+        emitFullscreenMarker(desired, before, "unavailable", source);
+        return;
+    }
+    if (before == desired) {
+        emitFullscreenMarker(desired, before, "noop", source);
+        return;
+    }
+
+    if (desired) {
+        const QRect normalCandidate = isMinimized()
+            ? normalGeometry() : geometry();
+        if (normalCandidate.isValid()) {
+            m_normalGeometry = normalCandidate;
+            m_hasNormalGeometry = true;
+        }
+        showFullScreen();
+    } else {
+        showNormal();
+        if (m_hasNormalGeometry && m_normalGeometry.isValid()) {
+            setGeometry(m_normalGeometry);
+        }
+    }
+
+    const bool after = isFullScreen();
+    emitFullscreenMarker(
+        desired,
+        after,
+        after == desired ? "applied" : "unavailable",
+        source);
+    if (m_videoSurface) {
+        m_videoSurface->setFocus(Qt::OtherFocusReason);
+    }
+}
+
+void RendererHostWindow::showRenderer() {
+    if (isFullScreen()) {
+        showFullScreen();
+    } else {
+        showNormal();
+    }
+    raise();
+    activateWindow();
+    if (m_videoSurface) {
+        m_videoSurface->setFocus(Qt::ActiveWindowFocusReason);
+    }
+}
+
+void RendererHostWindow::hideRenderer() {
+    applyFullscreenState(false, "lifecycle");
+    hide();
+}
+
+bool RendererHostWindow::nativeEvent(
+        const QByteArray &eventType,
+        void *message,
+        qintptr *result) {
+    (void) eventType;
+    MSG *nativeMessage = static_cast<MSG *>(message);
+    if (!nativeMessage) {
+        return QMainWindow::nativeEvent(eventType, message, result);
+    }
+
+    switch (nativeMessage->message) {
+    case AEROMIRROR_WM_RENDERER_SHOW:
+        showRenderer();
+        if (result) *result = 0;
+        return true;
+    case AEROMIRROR_WM_RENDERER_HIDE:
+        hideRenderer();
+        if (result) *result = 0;
+        return true;
+    case AEROMIRROR_WM_RENDERER_FULLSCREEN_SET: {
+        const char *source = nativeMessage->lParam ==
+            AEROMIRROR_FULLSCREEN_SOURCE_INITIAL
+            ? "initial" : "ipc";
+        applyFullscreenState(nativeMessage->wParam == 1, source);
+        if (result) *result = 0;
+        return true;
+    }
+    case WM_SYSCOMMAND:
+        if ((nativeMessage->wParam & 0xfff0u) == SC_MAXIMIZE) {
+            applyFullscreenState(true, "caption");
+            if (result) *result = 0;
+            return true;
+        }
+        break;
+    case WM_KEYDOWN:
+        if (nativeMessage->wParam == VK_ESCAPE) {
+            applyFullscreenState(false, "escape");
+            if (result) *result = 0;
+            return true;
+        }
+        break;
+    case WM_SYSKEYDOWN:
+        if (nativeMessage->wParam == VK_RETURN &&
+            (GetKeyState(VK_MENU) & 0x8000)) {
+            applyFullscreenState(!isFullScreen(), "alt-enter");
+            if (result) *result = 0;
+            return true;
+        }
+        break;
+    default:
+        break;
+    }
+
+    return QMainWindow::nativeEvent(eventType, message, result);
+}
+
+bool RendererHostWindow::eventFilter(QObject *watched, QEvent *event) {
+    if (watched == m_videoSurface && event &&
+        event->type() == QEvent::KeyPress) {
+        QKeyEvent *keyEvent = static_cast<QKeyEvent *>(event);
+        if (keyEvent->key() == Qt::Key_Escape) {
+            applyFullscreenState(false, "escape");
+            return true;
+        }
+        if ((keyEvent->key() == Qt::Key_Return ||
+             keyEvent->key() == Qt::Key_Enter) &&
+            keyEvent->modifiers().testFlag(Qt::AltModifier)) {
+            if (!keyEvent->isAutoRepeat()) {
+                applyFullscreenState(!isFullScreen(), "alt-enter");
+            }
+            return true;
+        }
+    }
+    return QMainWindow::eventFilter(watched, event);
+}
+
+void RendererHostWindow::closeEvent(QCloseEvent *event) {
+    applyFullscreenState(false, "lifecycle");
+    showMinimized();
+    event->ignore();
+}
