+
+void RendererHostWindow::scheduleHandleRebind(unsigned int attempt) {
+    if (m_handleRebindScheduled || m_rebindingHandles ||
+        !m_controlHandle || !m_renderHandle || !m_videoSurface) {
+        return;
+    }
+    m_handleRebindScheduled = true;
+    const int delayMs = attempt == 0 ? 0 : 25;
+    QTimer::singleShot(delayMs, this, [this, attempt]() {
+        m_handleRebindScheduled = false;
+        if (m_rebindingHandles || !m_videoSurface) {
+            return;
+        }
+
+        m_rebindingHandles = true;
+        const uintptr_t previousControl = m_controlHandle;
+        const uintptr_t previousRender = m_renderHandle;
+        const uintptr_t currentControl =
+            static_cast<uintptr_t>(winId());
+        const uintptr_t currentRender =
+            static_cast<uintptr_t>(m_videoSurface->winId());
+        const bool valid = currentControl && currentRender &&
+            IsWindow(reinterpret_cast<HWND>(currentControl)) &&
+            IsWindow(reinterpret_cast<HWND>(currentRender));
+        if (valid &&
+            (currentControl != previousControl ||
+             currentRender != previousRender)) {
+            m_controlHandle = currentControl;
+            m_renderHandle = currentRender;
+            m_showGeneration = 0;
+            m_hostReadyAcknowledgedGeneration = 0;
+            m_readyRetryPendingGeneration = 0;
+            m_surfaceRefreshPendingGeneration = 0;
+            set_video_host_handles(currentRender, currentControl);
+            fprintf(stdout,
+                    "\nAEROMIRROR_VIDEO_HOST_REBIND result=requested "
+                    "old-render=%llu new-render=%llu "
+                    "old-control=%llu new-control=%llu\n",
+                    static_cast<unsigned long long>(previousRender),
+                    static_cast<unsigned long long>(currentRender),
+                    static_cast<unsigned long long>(previousControl),
+                    static_cast<unsigned long long>(currentControl));
+            fflush(stdout);
+        } else if (!valid && attempt >= 60) {
+            fprintf(stdout,
+                    "\nAEROMIRROR_VIDEO_HOST_REBIND result=failed "
+                    "reason=invalid-window\n");
+            fflush(stdout);
+        }
+        m_rebindingHandles = false;
+        if (!valid && attempt < 60) {
+            scheduleHandleRebind(attempt + 1);
+        }
+    });
+}
+
+void RendererHostWindow::emitFullscreenMarker(
+        bool requested,
+        bool actual,
+        const char *result,
+        const char *source) const {
+    fprintf(stdout,
+            "\nAEROMIRROR_VIDEO_FULLSCREEN requested=%d actual=%d "
+            "result=%s generation=%llu source=%s\n",
+            requested ? 1 : 0,
+            actual ? 1 : 0,
+            result,
+            static_cast<unsigned long long>(m_fullscreenGeneration),
+            source);
+    fflush(stdout);
+}
+
+void RendererHostWindow::applyFullscreenState(
+        bool desired,
+        const char *source) {
+    ++m_fullscreenGeneration;
+    const bool before = isFullScreen();
+    const bool initialRequest =
+        source && std::strcmp(source, "initial") == 0;
+    HWND foreground = GetForegroundWindow();
+    HWND host = reinterpret_cast<HWND>(controlHandle());
+    if (desired && initialRequest &&
+        (m_connectionForegroundDeferred ||
+         isExternalFullscreenForeground(foreground, host))) {
+        m_connectionForegroundDeferred = false;
+        emitFullscreenMarker(desired, before, "deferred", source);
+        return;
+    }
+    if (initialRequest) {
+        m_connectionForegroundDeferred = false;
+    }
+    if (desired && !isVisible()) {
+        emitFullscreenMarker(desired, before, "unavailable", source);
+        return;
+    }
+    if (before == desired) {
+        emitFullscreenMarker(desired, before, "noop", source);
+        return;
+    }
+
+    if (desired) {
+        const QRect normalCandidate = (isMinimized() || isMaximized())
+            ? normalGeometry() : geometry();
+        if (normalCandidate.isValid()) {
+            m_normalGeometry = normalCandidate;
+            m_hasNormalGeometry = true;
+        }
+        if (host && IsWindow(host)) {
+            m_normalWindowStyle = GetWindowLongPtrW(host, GWL_STYLE) &
+                ~(static_cast<LONG_PTR>(WS_MINIMIZE) |
+                  static_cast<LONG_PTR>(WS_MAXIMIZE));
+            m_normalWindowExStyle = GetWindowLongPtrW(host, GWL_EXSTYLE);
+            m_hasNormalWindowStyle = true;
+        }
+        showFullScreen();
+        if (host && IsWindow(host)) {
+            LONG_PTR style = GetWindowLongPtrW(host, GWL_STYLE);
+            style &= ~(WS_CAPTION | WS_THICKFRAME | WS_MINIMIZEBOX |
+                       WS_MAXIMIZEBOX | WS_SYSMENU);
+            SetWindowLongPtrW(host, GWL_STYLE, style);
+            MONITORINFO monitorInfo = {};
+            monitorInfo.cbSize = sizeof(monitorInfo);
+            HMONITOR monitor = MonitorFromWindow(
+                host, MONITOR_DEFAULTTONEAREST);
+            if (monitor && GetMonitorInfoW(monitor, &monitorInfo)) {
+                const RECT &bounds = monitorInfo.rcMonitor;
+                SetWindowPos(
+                    host, HWND_TOP,
+                    bounds.left, bounds.top,
+                    bounds.right - bounds.left,
+                    bounds.bottom - bounds.top,
+                    SWP_FRAMECHANGED | SWP_NOOWNERZORDER |
+                    SWP_NOACTIVATE);
+            } else {
+                SetWindowPos(
+                    host, nullptr, 0, 0, 0, 0,
+                    SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE |
+                    SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOACTIVATE);
+            }
+        }
+    } else {
+        showNormal();
+        HWND host = reinterpret_cast<HWND>(controlHandle());
+        if (host && IsWindow(host) && m_hasNormalWindowStyle) {
+            SetWindowLongPtrW(
+                host, GWL_STYLE,
+                static_cast<LONG_PTR>(m_normalWindowStyle));
+            SetWindowLongPtrW(
+                host, GWL_EXSTYLE,
+                static_cast<LONG_PTR>(m_normalWindowExStyle));
+            SetWindowPos(
+                host, nullptr, 0, 0, 0, 0,
+                SWP_FRAMECHANGED | SWP_NOMOVE | SWP_NOSIZE |
+                SWP_NOZORDER | SWP_NOOWNERZORDER | SWP_NOACTIVATE);
+        }
+        if (m_hasNormalGeometry && m_normalGeometry.isValid()) {
+            setGeometry(m_normalGeometry);
+            const QRect restoreGeometry = m_normalGeometry;
+            const uint64_t restoreGeneration = m_fullscreenGeneration;
+            QTimer::singleShot(0, this,
+                [this, restoreGeometry, restoreGeneration]() {
+                    if (m_fullscreenGeneration == restoreGeneration &&
+                        !isFullScreen() && restoreGeometry.isValid()) {
+                        setGeometry(restoreGeometry);
+                    }
+                });
+        }
+    }
+
+    const bool after = isFullScreen();
+    emitFullscreenMarker(
+        desired,
+        after,
+        after == desired ? "applied" : "unavailable",
+        source);
+    if (m_videoSurface) {
+        m_videoSurface->setFocus(Qt::OtherFocusReason);
+    }
+}
+
+void RendererHostWindow::showRenderer(uint64_t generation, uint64_t sessionId) {
+    if (!generation || (sessionId && sessionId == m_dismissedSessionId)) {
+        return;
+    }
+    m_sessionId = sessionId;
+    m_showGeneration = generation;
+    m_hostReadyAcknowledgedGeneration = 0;
+    m_readyRetryPendingGeneration = 0;
+    m_surfaceRefreshPendingGeneration = 0;
+    HWND host = reinterpret_cast<HWND>(controlHandle());
+    HWND priorForeground = GetForegroundWindow();
+    const bool priorFullscreen = isExternalFullscreenForeground(
+        priorForeground, host);
+    setAttribute(Qt::WA_ShowWithoutActivating, true);
+    if (isFullScreen()) {
+        showFullScreen();
+    } else {
+        showNormal();
+    }
+    HWND currentForeground = GetForegroundWindow();
+    HWND protectedForeground = nullptr;
+    if (isExternalFullscreenForeground(currentForeground, host)) {
+        protectedForeground = currentForeground;
+    } else if (priorFullscreen && priorForeground &&
+               IsWindow(priorForeground)) {
+        protectedForeground = priorForeground;
+    }
+    const bool deferActivation = protectedForeground != nullptr;
+    m_connectionForegroundDeferred = deferActivation;
+
+    BOOL placementApplied = FALSE;
+    bool usedFallback = false;
+    constexpr UINT placementFlags =
+        SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE |
+        SWP_NOOWNERZORDER | SWP_SHOWWINDOW;
+    if (host && IsWindow(host)) {
+        const BOOL nonTopmost = SetWindowPos(
+            host, HWND_NOTOPMOST, 0, 0, 0, 0, placementFlags);
+        if (deferActivation && nonTopmost) {
+            const bool foregroundTopmost =
+                (GetWindowLongPtrW(
+                    protectedForeground, GWL_EXSTYLE) & WS_EX_TOPMOST) != 0;
+            placementApplied = foregroundTopmost
+                ? SetWindowPos(
+                    host, HWND_BOTTOM, 0, 0, 0, 0,
+                    placementFlags)
+                : SetWindowPos(
+                    host, protectedForeground, 0, 0, 0, 0,
+                    placementFlags);
+        } else if (!deferActivation && nonTopmost) {
+            placementApplied = SetWindowPos(
+                host, HWND_TOP, 0, 0, 0, 0, placementFlags);
+            // A background HWND_TOP call can succeed without passing other
+            // applications. Make one synchronous topmost/demotion transaction
+            // only if ordinary windows still cover us; never retain topmost.
+            if (placementApplied && hasOrdinaryWindowAbove(host)) {
+                usedFallback = true;
+                const HWND latestForeground = GetForegroundWindow();
+                if (isExternalFullscreenForeground(latestForeground, host)) {
+                    m_connectionForegroundDeferred = true;
+                    placementApplied = SetWindowPos(
+                        host, HWND_BOTTOM, 0, 0, 0, 0, placementFlags);
+                } else {
+                    const BOOL promoted = SetWindowPos(
+                        host, HWND_TOPMOST, 0, 0, 0, 0, placementFlags);
+                    const BOOL demoted = SetWindowPos(
+                        host, HWND_NOTOPMOST, 0, 0, 0, 0, placementFlags);
+                    placementApplied = promoted && demoted &&
+                        !hasOrdinaryWindowAbove(host);
+                }
+            }
+        }
+        if (!placementApplied) {
+            usedFallback = true;
+            if (m_connectionForegroundDeferred) {
+                placementApplied = SetWindowPos(
+                    host, HWND_BOTTOM, 0, 0, 0, 0, placementFlags);
+            } else {
+                const BOOL retryNonTopmost = SetWindowPos(
+                    host, HWND_NOTOPMOST, 0, 0, 0, 0, placementFlags);
+                if (retryNonTopmost) {
+                    placementApplied = SetWindowPos(
+                        host, HWND_TOP, 0, 0, 0, 0, placementFlags);
+                }
+            }
+        }
+        if (placementApplied &&
+            (GetWindowLongPtrW(host, GWL_EXSTYLE) & WS_EX_TOPMOST)) {
+            usedFallback = true;
+            placementApplied = SetWindowPos(
+                host,
+                m_connectionForegroundDeferred ? HWND_BOTTOM : HWND_NOTOPMOST,
+                0, 0, 0, 0, placementFlags);
+            if (placementApplied && !m_connectionForegroundDeferred) {
+                placementApplied = SetWindowPos(
+                    host, HWND_TOP, 0, 0, 0, 0, placementFlags);
+            }
+        }
+        if (GetWindowLongPtrW(host, GWL_EXSTYLE) & WS_EX_TOPMOST) {
+            ShowWindow(host, SW_HIDE);
+            placementApplied = FALSE;
+        }
+        if (placementApplied && !m_connectionForegroundDeferred &&
+            hasOrdinaryWindowAbove(host)) {
+            placementApplied = FALSE;
+        }
+    }
+    fprintf(stdout,
+            "\nAEROMIRROR_VIDEO_HOST_FOREGROUND result=%s "
+            "reason=%s fallback=%d\n",
+            placementApplied
+                ? (m_connectionForegroundDeferred ? "deferred" : "raised")
+                : "failed",
+            m_connectionForegroundDeferred
+                ? "fullscreen-foreground" : "ordinary-foreground",
+            usedFallback ? 1 : 0);
+    fflush(stdout);
+    queueRendererReady(generation);
+}
+
+void RendererHostWindow::queueRendererReady(
+        uint64_t generation,
+        unsigned int attempt) {
+    if (!generation || generation != m_showGeneration ||
+        m_hostReadyAcknowledgedGeneration == generation ||
+        m_readyRetryPendingGeneration == generation) {
+        return;
+    }
+    constexpr unsigned int maximumAttempts = 60;
+    const int delayMs = attempt == 0 ? 0 : 25;
+    m_readyRetryPendingGeneration = generation;
+    QTimer::singleShot(delayMs, this, [this, generation, attempt]() {
+        if (m_readyRetryPendingGeneration == generation) {
+            m_readyRetryPendingGeneration = 0;
+        }
+        if (generation != m_showGeneration ||
+            m_hostReadyAcknowledgedGeneration == generation ||
+            !m_videoSurface) {
+            return;
+        }
+        HWND host = reinterpret_cast<HWND>(controlHandle());
+        HWND surface = reinterpret_cast<HWND>(renderHandle());
+        RECT client = {0};
+        const BOOL visible = isVisible() && host && !IsIconic(host) &&
+            surface && IsWindowVisible(surface);
+        const BOOL hasClient = surface && GetClientRect(surface, &client);
+        const LONG width = hasClient ? client.right - client.left : 0;
+        const LONG height = hasClient ? client.bottom - client.top : 0;
+        const bool ready = visible && width > 0 && height > 0;
+        if (!ready && attempt < maximumAttempts) {
+            queueRendererReady(generation, attempt + 1);
+            return;
+        }
+        int hostAcknowledged = 0;
+        if (ready) {
+            hostAcknowledged = notify_video_host_shown(
+                renderHandle(),
+                static_cast<unsigned int>(width),
+                static_cast<unsigned int>(height),
+                static_cast<unsigned long long>(generation));
+        }
+        if (hostAcknowledged) {
+            m_hostReadyAcknowledgedGeneration = generation;
+        } else if (ready && attempt < maximumAttempts) {
+            queueRendererReady(generation, attempt + 1);
+            return;
+        }
+        fprintf(stdout,
+                "\nAEROMIRROR_VIDEO_HOST_SHOW result=%s generation=%llu "
+                "visible=%d client=%ldx%ld ack=%s\n",
+                ready ? "ready" : "invalid-surface",
+                static_cast<unsigned long long>(generation),
+                visible ? 1 : 0,
+                width,
+                height,
+                hostAcknowledged ? "accepted" : "unavailable");
+        fflush(stdout);
+    });
+}
+
+void RendererHostWindow::queueRendererExpose(
+        uint64_t generation,
+        unsigned int attempt) {
+    if (!generation || generation != m_showGeneration) {
+        return;
+    }
+    constexpr unsigned int maximumAttempts = 60;
+    const int delayMs = attempt == 0 ? 0 : 25;
+    QTimer::singleShot(delayMs, this, [this, generation, attempt]() {
+        if (generation != m_showGeneration ||
+            !m_videoSurface) {
+            return;
+        }
+        HWND host = reinterpret_cast<HWND>(controlHandle());
+        HWND surface = reinterpret_cast<HWND>(renderHandle());
+        RECT client = {0};
+        const BOOL visible = isVisible() && host && !IsIconic(host) &&
+            surface && IsWindowVisible(surface);
+        const BOOL hasClient = surface && GetClientRect(surface, &client);
+        const LONG width = hasClient ? client.right - client.left : 0;
+        const LONG height = hasClient ? client.bottom - client.top : 0;
+        if (!visible || width <= 0 || height <= 0) {
+            if (attempt < maximumAttempts) {
+                queueRendererExpose(generation, attempt + 1);
+                return;
+            }
+            const int abandoned = abandon_video_host_surface_expose(
+                static_cast<unsigned long long>(generation));
+            fprintf(stdout,
+                    "\nAEROMIRROR_VIDEO_HOST_EXPOSE result=deferred "
+                    "generation=%llu attempts=%u rearmed=%d\n",
+                    static_cast<unsigned long long>(generation),
+                    attempt,
+                    abandoned ? 1 : 0);
+            fflush(stdout);
+            return;
+        }
+        const int exposed = expose_video_host_surface(
+            renderHandle(),
+            static_cast<unsigned int>(width),
+            static_cast<unsigned int>(height),
+            static_cast<unsigned long long>(generation));
+        fprintf(stdout,
+                "\nAEROMIRROR_VIDEO_HOST_EXPOSE result=%s "
+                "generation=%llu client=%ldx%ld trigger=present-ready\n",
+                exposed ? "requested" : "rejected",
+                static_cast<unsigned long long>(generation),
+                width,
+                height);
+        fflush(stdout);
+    });
+}
+
+void RendererHostWindow::hideRenderer(uint64_t generation) {
+    if (!generation) {
+        return;
+    }
+    m_showGeneration = generation;
+    m_hostReadyAcknowledgedGeneration = 0;
+    m_readyRetryPendingGeneration = 0;
+    m_surfaceRefreshPendingGeneration = 0;
+    m_connectionForegroundDeferred = false;
+    applyFullscreenState(false, "lifecycle");
+    hide();
+}
+
+bool RendererHostWindow::nativeEvent(
+        const QByteArray &eventType,
+        void *message,
+        qintptr *result) {
+    (void) eventType;
+    MSG *nativeMessage = static_cast<MSG *>(message);
+    if (!nativeMessage) {
+        return QMainWindow::nativeEvent(eventType, message, result);
+    }
+
+    switch (nativeMessage->message) {
+    case AEROMIRROR_WM_RENDERER_SHOW:
+        showRenderer(static_cast<uint64_t>(nativeMessage->wParam),
+                     static_cast<uint64_t>(nativeMessage->lParam));
+        if (result) *result = 0;
+        return true;
+    case AEROMIRROR_WM_RENDERER_HIDE:
+        hideRenderer(static_cast<uint64_t>(nativeMessage->wParam));
+        if (result) *result = 0;
+        return true;
+    case AEROMIRROR_WM_RENDERER_CLOSE_SESSION:
+        closeSession(static_cast<uint64_t>(nativeMessage->wParam),
+                     "continuity-close");
+        if (result) *result = 0;
+        return true;
+    case AEROMIRROR_WM_RENDERER_EXPOSE:
+        queueRendererExpose(
+            static_cast<uint64_t>(nativeMessage->wParam));
+        if (result) *result = 0;
+        return true;
+    case AEROMIRROR_WM_RENDERER_FULLSCREEN_SET: {
+        const char *source = nativeMessage->lParam ==
+            AEROMIRROR_FULLSCREEN_SOURCE_INITIAL
+            ? "initial" : "ipc";
+        applyFullscreenState(nativeMessage->wParam == 1, source);
+        if (result) *result = 0;
+        return true;
+    }
+    case WM_SYSCOMMAND:
+        if ((nativeMessage->wParam & 0xfff0u) == SC_MAXIMIZE) {
+            applyFullscreenState(true, "caption");
+            if (result) *result = 0;
+            return true;
+        }
+        break;
+    case WM_KEYDOWN:
+        if (nativeMessage->wParam == VK_ESCAPE && isFullScreen()) {
+            applyFullscreenState(false, "escape");
+            if (result) *result = 0;
+            return true;
+        }
+        break;
+    case WM_SYSKEYDOWN:
+        if (nativeMessage->wParam == VK_RETURN &&
+            (GetKeyState(VK_MENU) & 0x8000)) {
+            applyFullscreenState(!isFullScreen(), "alt-enter");
+            if (result) *result = 0;
+            return true;
+        }
+        break;
+    default:
+        break;
+    }
+
+    return QMainWindow::nativeEvent(eventType, message, result);
+}
+
+bool RendererHostWindow::eventFilter(QObject *watched, QEvent *event) {
+    QWidget *target = qobject_cast<QWidget *>(watched);
+    const bool rendererTarget = target &&
+        (target == this || target == m_videoSurface || isAncestorOf(target));
+    const bool lifecycleTarget = target &&
+        (target == this || target == m_videoSurface);
+    if (lifecycleTarget && event &&
+        event->type() == QEvent::WinIdChange) {
+        scheduleHandleRebind();
+    } else if (lifecycleTarget && event &&
+               (event->type() == QEvent::Show ||
+                event->type() == QEvent::WindowStateChange) &&
+               m_showGeneration && isVisible() && !isMinimized()) {
+        const uint64_t generation = m_showGeneration;
+        if (m_surfaceRefreshPendingGeneration != generation) {
+            const bool reexpose =
+                m_hostReadyAcknowledgedGeneration == generation;
+            m_surfaceRefreshPendingGeneration = generation;
+            QTimer::singleShot(25, this, [this, generation, reexpose]() {
+                if (m_surfaceRefreshPendingGeneration == generation) {
+                    m_surfaceRefreshPendingGeneration = 0;
+                }
+                if (generation != m_showGeneration || !isVisible() ||
+                    isMinimized()) {
+                    return;
+                }
+                queueRendererReady(generation);
+                if (reexpose) {
+                    request_video_host_surface_expose(
+                        static_cast<unsigned long long>(generation));
+                }
+            });
+        }
+    }
+    if (rendererTarget && event && event->type() == QEvent::KeyPress) {
+        QKeyEvent *keyEvent = static_cast<QKeyEvent *>(event);
+        if (keyEvent->key() == Qt::Key_Escape && isFullScreen()) {
+            applyFullscreenState(false, "escape");
+            return true;
+        }
+        if ((keyEvent->key() == Qt::Key_Return ||
+             keyEvent->key() == Qt::Key_Enter) &&
+            keyEvent->modifiers().testFlag(Qt::AltModifier)) {
+            if (!keyEvent->isAutoRepeat()) {
+                applyFullscreenState(!isFullScreen(), "alt-enter");
+            }
+            return true;
+        }
+    }
+    return QMainWindow::eventFilter(watched, event);
+}
+
+void RendererHostWindow::closeEvent(QCloseEvent *event) {
+    event->ignore(); /* The receiver owns this reusable host. */
+    closeSession(m_sessionId, "caption-close");
+}
+
+void RendererHostWindow::closeSession(uint64_t sessionId, const char *source) {
+    if (!sessionId || sessionId != m_sessionId) {
+        fprintf(stdout,
+            "\nAEROMIRROR_COMMAND_REJECTED command=close-session "
+            "session=%llu reason=stale\n",
+            static_cast<unsigned long long>(sessionId));
+        fflush(stdout);
+        return;
+    }
+    if (sessionId == m_dismissedSessionId ||
+        m_closeRequestSequence == UINT64_MAX) return;
+    const uint64_t requestId = ++m_closeRequestSequence;
+    if (!request_mirroring_session_close(sessionId, requestId)) {
+        fprintf(stdout,
+            "\nAEROMIRROR_SESSION_CLOSE session=%llu request=%llu "
+            "result=unavailable source=%s\n",
+            static_cast<unsigned long long>(sessionId),
+            static_cast<unsigned long long>(requestId), source);
+        fflush(stdout);
+        return; /* Never hide a still-running phone on admission failure. */
+    }
+    m_dismissedSessionId = sessionId;
+    m_hostReadyAcknowledgedGeneration = 0;
+    m_readyRetryPendingGeneration = 0;
+    m_surfaceRefreshPendingGeneration = 0;
+    applyFullscreenState(false, "lifecycle");
+    fprintf(stdout,
+            "\nAEROMIRROR_VIDEO_WINDOW state=closed source=%s "
+            "session=%llu request=%llu\n",
+            source,
+            static_cast<unsigned long long>(sessionId),
+            static_cast<unsigned long long>(requestId));
+    fflush(stdout);
+    hide();
+}
