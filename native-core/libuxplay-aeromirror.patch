+static void aeromirror_reset_audio_clock(uint64_t generation) {
+    (void) generation;
+    std::lock_guard<std::mutex> guard(aeromirror_audio_clock_mutex);
+    aeromirror_audio_clock.initialized = false;
+    aeromirror_audio_clock.offset_ns = 0;
+    aeromirror_audio_clock.epoch =
+        aeromirror_audio_clock_epoch_counter.fetch_add(1) + 1;
+}
+
+static bool aeromirror_add_signed_ns(uint64_t raw_remote_pts,
+                                     int64_t offset_ns,
+                                     uint64_t *candidate_pts) {
+    if (!candidate_pts) {
+        return false;
+    }
+    if (offset_ns >= 0) {
+        uint64_t positive = (uint64_t) offset_ns;
+        if (raw_remote_pts > UINT64_MAX - positive) {
+            return false;
+        }
+        *candidate_pts = raw_remote_pts + positive;
+        return true;
+    }
+    uint64_t magnitude = (uint64_t) (-(offset_ns + 1)) + 1;
+    if (raw_remote_pts < magnitude) {
+        return false;
+    }
+    *candidate_pts = raw_remote_pts - magnitude;
+    return true;
+}
+
+static uint64_t aeromirror_age_ms(gint64 now_us, uint64_t then_us) {
+    if (!then_us || now_us <= 0 || (uint64_t) now_us <= then_us) {
+        return then_us ? 0 : UINT64_MAX;
+    }
+    return ((uint64_t) now_us - then_us) / 1000U;
+}
