diff --git a/lib/mirror_payload_parser.c b/lib/mirror_payload_parser.c
new file mode 100644
index 0000000000000000000000000000000000000000..384b1c479179208365a7632c0c641415943d39dd
--- /dev/null
+++ b/lib/mirror_payload_parser.c
@@ -0,0 +1,211 @@
+#include "mirror_payload_parser.h"
+
+#include <limits.h>
+#include <string.h>
+
+typedef struct mirror_cursor_s {
+    const uint8_t *data;
+    size_t len;
+    size_t off;
+} mirror_cursor_t;
+
+static bool
+mirror_cursor_take(mirror_cursor_t *cursor, size_t len,
+                   const uint8_t **span)
+{
+    if (!cursor || !span || cursor->off > cursor->len ||
+        len > cursor->len - cursor->off) {
+        return false;
+    }
+    *span = cursor->data + cursor->off;
+    cursor->off += len;
+    return true;
+}
+
+static uint16_t
+mirror_read_be16(const uint8_t *data)
+{
+    return (uint16_t) (((uint16_t) data[0] << 8) | data[1]);
+}
+
+static uint32_t
+mirror_read_be32(const uint8_t *data)
+{
+    return ((uint32_t) data[0] << 24) |
+           ((uint32_t) data[1] << 16) |
+           ((uint32_t) data[2] << 8) |
+           (uint32_t) data[3];
+}
+
+bool
+mirror_payload_size_allowed(uint8_t packet_type, size_t payload_size)
+{
+    switch (packet_type) {
+    case 0x00:
+        return payload_size <= MIRROR_VIDEO_PAYLOAD_MAX;
+    case 0x01:
+        return payload_size <= MIRROR_CONFIG_PAYLOAD_MAX;
+    case 0x05:
+        return payload_size <= MIRROR_REPORT_PAYLOAD_MAX;
+    default:
+        return payload_size <= MIRROR_CONTROL_PAYLOAD_MAX;
+    }
+}
+
+bool
+mirror_size_add(size_t left, size_t right, size_t *result)
+{
+    if (!result || right > SIZE_MAX - left) {
+        return false;
+    }
+    *result = left + right;
+    return true;
+}
+
+bool
+mirror_payload_is_h265(const uint8_t *payload, size_t payload_size)
+{
+    static const uint8_t hvc1[] = {0x68, 0x76, 0x63, 0x31};
+    return payload && payload_size >= 8 &&
+           memcmp(payload + 4, hvc1, sizeof(hvc1)) == 0;
+}
+
+bool
+mirror_parse_h264_config(const uint8_t *payload, size_t payload_size,
+                         mirror_codec_config_t *config)
+{
+    const uint8_t *prefix;
+    const uint8_t *sps;
+    const uint8_t *pps_header;
+    const uint8_t *pps;
+    mirror_cursor_t cursor;
+    size_t sps_size;
+    size_t pps_size;
+
+    if (!payload || !config || payload_size > MIRROR_CONFIG_PAYLOAD_MAX) {
+        return false;
+    }
+
+    cursor.data = payload;
+    cursor.len = payload_size;
+    cursor.off = 0;
+    if (!mirror_cursor_take(&cursor, 8, &prefix)) {
+        return false;
+    }
+    sps_size = mirror_read_be16(prefix + 6);
+    if (sps_size == 0 || !mirror_cursor_take(&cursor, sps_size, &sps)) {
+        return false;
+    }
+
+    /* One PPS-count byte followed by its two-byte big-endian length. */
+    if (!mirror_cursor_take(&cursor, 3, &pps_header)) {
+        return false;
+    }
+    pps_size = mirror_read_be16(pps_header + 1);
+    if (pps_size == 0 || !mirror_cursor_take(&cursor, pps_size, &pps)) {
+        return false;
+    }
+
+    memset(config, 0, sizeof(*config));
+    config->sps.data = sps;
+    config->sps.len = sps_size;
+    config->pps.data = pps;
+    config->pps.len = pps_size;
+    return true;
+}
+
+static bool
+mirror_take_h265_nal(mirror_cursor_t *cursor, uint8_t marker,
+                     mirror_payload_span_t *span)
+{
+    const uint8_t *header;
+    const uint8_t *nal;
+    size_t nal_size;
+
+    if (!mirror_cursor_take(cursor, 5, &header) ||
+        header[0] != marker || header[1] != 0x00 || header[2] != 0x01 ||
+        header[3] != 0x00) {
+        return false;
+    }
+    nal_size = mirror_read_be16(header + 3);
+    if (nal_size == 0 || !mirror_cursor_take(cursor, nal_size, &nal)) {
+        return false;
+    }
+    span->data = nal;
+    span->len = nal_size;
+    return true;
+}
+
+bool
+mirror_parse_h265_config(const uint8_t *payload, size_t payload_size,
+                         mirror_codec_config_t *config)
+{
+    const uint8_t *prefix;
+    mirror_codec_config_t parsed;
+    mirror_cursor_t cursor;
+
+    if (!payload || !config || payload_size > MIRROR_CONFIG_PAYLOAD_MAX ||
+        !mirror_payload_is_h265(payload, payload_size)) {
+        return false;
+    }
+
+    memset(&parsed, 0, sizeof(parsed));
+    parsed.is_h265 = true;
+    cursor.data = payload;
+    cursor.len = payload_size;
+    cursor.off = 0;
+    if (!mirror_cursor_take(&cursor, 0x75, &prefix) ||
+        !mirror_take_h265_nal(&cursor, 0xa0, &parsed.vps) ||
+        !mirror_take_h265_nal(&cursor, 0xa1, &parsed.sps) ||
+        !mirror_take_h265_nal(&cursor, 0xa2, &parsed.pps)) {
+        return false;
+    }
+
+    *config = parsed;
+    return true;
+}
+
+bool
+mirror_convert_nalus(uint8_t *payload, size_t payload_size, bool is_h265,
+                     size_t *nal_count)
+{
+    static const uint8_t nal_start_code[] = {0x00, 0x00, 0x00, 0x01};
+    size_t count = 0;
+    size_t offset = 0;
+    size_t minimum_nal_size = is_h265 ? 2U : 1U;
+
+    if (!payload || !nal_count || payload_size == 0 ||
+        payload_size > MIRROR_VIDEO_PAYLOAD_MAX) {
+        return false;
+    }
+
+    /* Validate the complete frame before changing any length prefix. */
+    while (offset < payload_size) {
+        uint32_t wire_len;
+        size_t remaining = payload_size - offset;
+        if (remaining < 4) {
+            return false;
+        }
+        wire_len = mirror_read_be32(payload + offset);
+        offset += 4;
+        remaining = payload_size - offset;
+        if ((size_t) wire_len < minimum_nal_size ||
+            (size_t) wire_len > remaining || (payload[offset] & 0x80) != 0) {
+            return false;
+        }
+        offset += (size_t) wire_len;
+        count++;
+    }
+    if (count > (size_t) INT_MAX) {
+        return false;
+    }
+
+    offset = 0;
+    while (offset < payload_size) {
+        uint32_t wire_len = mirror_read_be32(payload + offset);
+        memcpy(payload + offset, nal_start_code, sizeof(nal_start_code));
+        offset += sizeof(nal_start_code) + (size_t) wire_len;
+    }
+    *nal_count = count;
+    return true;
+}
diff --git a/lib/mirror_payload_parser.h b/lib/mirror_payload_parser.h
new file mode 100644
index 0000000000000000000000000000000000000000..cbcc9ad6162a12ac170a5ddc0b474c4de0b3d225
--- /dev/null
+++ b/lib/mirror_payload_parser.h
@@ -0,0 +1,46 @@
+/*
+ * Small, length-aware parsers for AirPlay mirroring payloads.
+ *
+ * The wire format is controlled by the remote peer.  Keep all cursor and
+ * allocation arithmetic in size_t and validate a span before exposing it to
+ * the mirroring worker.
+ */
+
+#ifndef AIRPLAYSERVER_MIRROR_PAYLOAD_PARSER_H
+#define AIRPLAYSERVER_MIRROR_PAYLOAD_PARSER_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#define MIRROR_VIDEO_PAYLOAD_MAX ((size_t) 32U * 1024U * 1024U)
+#define MIRROR_CONFIG_PAYLOAD_MAX ((size_t) 256U * 1024U)
+#define MIRROR_REPORT_PLIST_MAX ((size_t) 1024U * 1024U)
+#define MIRROR_REPORT_TRAILER_SIZE ((size_t) 25000U)
+#define MIRROR_REPORT_PAYLOAD_MAX \
+    (MIRROR_REPORT_PLIST_MAX + MIRROR_REPORT_TRAILER_SIZE)
+#define MIRROR_CONTROL_PAYLOAD_MAX ((size_t) 64U * 1024U)
+
+typedef struct mirror_payload_span_s {
+    const uint8_t *data;
+    size_t len;
+} mirror_payload_span_t;
+
+typedef struct mirror_codec_config_s {
+    bool is_h265;
+    mirror_payload_span_t vps;
+    mirror_payload_span_t sps;
+    mirror_payload_span_t pps;
+} mirror_codec_config_t;
+
+bool mirror_payload_size_allowed(uint8_t packet_type, size_t payload_size);
+bool mirror_size_add(size_t left, size_t right, size_t *result);
+bool mirror_payload_is_h265(const uint8_t *payload, size_t payload_size);
+bool mirror_parse_h264_config(const uint8_t *payload, size_t payload_size,
+                              mirror_codec_config_t *config);
+bool mirror_parse_h265_config(const uint8_t *payload, size_t payload_size,
+                              mirror_codec_config_t *config);
+bool mirror_convert_nalus(uint8_t *payload, size_t payload_size, bool is_h265,
+                          size_t *nal_count);
+
+#endif /* AIRPLAYSERVER_MIRROR_PAYLOAD_PARSER_H */
