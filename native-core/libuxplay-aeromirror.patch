+static bool aeromirror_is_four_digit_pin(const char pin[5]) {
+    if (!pin || pin[4] != '\0') return false;
+    for (size_t index = 0; index < 4; ++index) {
+        if (pin[index] < '0' || pin[index] > '9') return false;
+    }
+    return true;
+}
+
+int submit_pairing_pin(
+        unsigned long long request_id,
+        const char pin[5]) {
+    if (!request_id || !aeromirror_is_four_digit_pin(pin) ||
+        do_shutdown.load()) {
+        return 0;
+    }
+
+    std::lock_guard<std::mutex> guard(aeromirror_pairing_pin_mutex);
+    if (aeromirror_pairing_pin_waiting_request != request_id ||
+        aeromirror_pairing_pin_response_ready ||
+        aeromirror_pairing_pin_cancelled) {
+        return 0;
+    }
+    memcpy(aeromirror_pairing_pin_response, pin, 5);
+    aeromirror_pairing_pin_response_ready = true;
+    aeromirror_pairing_pin_condition.notify_all();
+    return 1;
+}
+
+int cancel_pairing_pin(unsigned long long request_id) {
+    if (!request_id) return 0;
+
+    bool emit_cancelled = false;
+    {
+        std::lock_guard<std::mutex> guard(aeromirror_pairing_pin_mutex);
+        if (aeromirror_pairing_pin_waiting_request == request_id) {
+            aeromirror_pairing_pin_cancelled = true;
+            aeromirror_pairing_pin_condition.notify_all();
+            return 1;
+        }
+        if (aeromirror_pairing_pin_active_request != request_id) return 0;
+        aeromirror_pairing_pin_active_request = 0;
+        emit_cancelled = true;
+    }
+    if (emit_cancelled) {
+        aeromirror_protocol_marker(
+            "AEROMIRROR_PAIRING_STATE request=%llu state=cancelled",
+            request_id);
+    }
+    return 1;
+}
+
+int request_discovery_refresh(unsigned long long request_id) {
+    if (!request_id || do_shutdown.load() ||
+        !aeromirror_discovery_capability_announced.load()) return 0;
+    uint64_t empty = 0;
+    if (!aeromirror_discovery_request.compare_exchange_strong(
+            empty, (uint64_t) request_id)) {
+        return empty == request_id ? 1 : 0;
+    }
+    GMainContext *context = NULL;
+    {
+        std::lock_guard<std::mutex> guard(aeromirror_context_mutex);
+        if (aeromirror_main_context) {
+            context = g_main_context_ref(aeromirror_main_context);
+        }
+    }
+    if (context) {
+        aeromirror_attach_discovery_request(context);
+        g_main_context_unref(context);
+    }
+    // A command admitted after capability announcement survives a transient
+    // video/GLib-loop reset.  The next owner-ready callback attaches it to the
+    // new owning iteration without restarting listeners or the process.
+    return 1;
+}
+
+static void aeromirror_attach_discovery_request(GMainContext *context) {
+    if (!context) return;
+    GSource *source = g_idle_source_new();
+    g_source_set_callback(
+        source, aeromirror_refresh_discovery_on_owner, NULL, NULL);
+    g_source_attach(source, context);
+    g_source_unref(source);
+}
