+/* AeroMirror control markers are a machine-readable line protocol embedded
+ * in ordinary UxPlay stdout. Audio progress uses a carriage return without a
+ * newline, so every protocol write begins with a newline and emits the whole
+ * marker plus its trailing newline in one stdio operation. */
+static void aeromirror_protocol_marker(const char *format, ...) {
+    std::lock_guard<std::mutex> guard(aeromirror_log_mutex);
+    char line[4098] = {0};
+    line[0] = '\n';
+    va_list vargs;
+    va_start(vargs, format);
+    int body_length = vsnprintf(line + 1, sizeof(line) - 2, format, vargs);
     va_end(vargs);
+    size_t length = 1 + (size_t) std::max(0, std::min(
+        body_length, (int) sizeof(line) - 3));
+    aeromirror_sanitize_control_bytes(line + 1);
+    if (!aeromirror_is_protocol_marker(line + 1)) return;
+    line[length++] = '\n';
+    line[length] = '\0';
+    fwrite(line, 1, length, stdout);
+    fflush(stdout);
 }
 
