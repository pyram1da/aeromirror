+static const char *playlist_find_bounded(const char *start, const char *end,
+                                         const char *needle,
+                                         size_t needle_len) {
+    if (!start || !end || !needle || needle_len == 0 || end < start ||
+        needle_len > (size_t) (end - start)) {
+        return NULL;
+    }
+    const char *limit = end - needle_len;
+    for (const char *ptr = start; ptr <= limit; ptr++) {
+        if (!memcmp(ptr, needle, needle_len)) {
+            return ptr;
+        }
+    }
+    return NULL;
+}
+
+static bool playlist_find_quoted_attribute(const char *line_start,
+                                           const char *line_end,
+                                           const char *name,
+                                           const char **value_start,
+                                           size_t *value_len) {
+    if (!line_start || !line_end || !name || !value_start || !value_len ||
+        line_end < line_start) {
+        return false;
+    }
+    size_t name_len = strlen(name);
+    const char *search = line_start;
+    while (search < line_end) {
+        const char *attribute = playlist_find_bounded(
+            search, line_end, name, name_len);
+        if (!attribute) {
+            return false;
+        }
+        bool has_boundary = attribute == line_start ||
+                            attribute[-1] == ':' || attribute[-1] == ',';
+        const char *open_quote = attribute + name_len;
+        if (has_boundary && open_quote < line_end && *open_quote == '"') {
+            const char *begin = open_quote + 1;
+            const char *close_quote = (const char *) memchr(
+                begin, '"', (size_t) (line_end - begin));
+            if (!close_quote) {
+                return false;
+            }
+            *value_start = begin;
+            *value_len = (size_t) (close_quote - begin);
+            return true;
+        }
+        search = attribute + 1;
+    }
+    return false;
+}
+
+static bool playlist_append_bytes(char **destination, size_t *remaining,
+                                  const char *source, size_t length) {
+    if (!destination || !*destination || !remaining ||
+        (!source && length != 0) || length > *remaining) {
+        return false;
+    }
+    if (length != 0) {
+        memcpy(*destination, source, length);
+        *destination += length;
+        *remaining -= length;
+    }
+    return true;
+}
