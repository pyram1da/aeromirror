+extern "C" void mirror_media_diagnostic(
+        void *cls, const mirror_media_diagnostic_t *event) {
+    (void) cls;
+    if (!event || !aeromirror_active_session_generation.load()) {
+        return;
+    }
+    aeromirror_geometry_generation.store(event->geometry_generation);
+    uint64_t previous_type0 = aeromirror_type0_packets.exchange(
+        event->type0_packets);
+    aeromirror_type0_bytes.store(event->type0_bytes);
+    uint64_t previous_type1 = aeromirror_type1_packets.exchange(
+        event->type1_packets);
+    aeromirror_type5_packets.store(event->type5_packets);
+    aeromirror_invalid_packets.store(event->invalid_packets);
+    if (event->type1_packets > previous_type1 ||
+        event->action != MIRROR_PACKET_ACTION_NONE) {
+        aeromirror_last_option.store((unsigned int) event->option);
+    }
+    if (event->action != MIRROR_PACKET_ACTION_NONE) {
+        aeromirror_last_action.store((unsigned int) event->action);
+    }
+    if (event->action == MIRROR_PACKET_ACTION_PAUSE) {
+        aeromirror_pause_actions.fetch_add(1);
+    } else if (event->action == MIRROR_PACKET_ACTION_RESUME) {
+        aeromirror_resume_actions.fetch_add(1);
+    } else if (event->action == MIRROR_PACKET_ACTION_IMPLICIT_RESUME) {
+        aeromirror_implicit_resume_actions.fetch_add(1);
+    }
+    aeromirror_stream_suspended.store(event->suspended);
+    if (event->config_result == MIRROR_CONFIG_RESULT_PENDING) {
+        aeromirror_config_pending.fetch_add(1);
+    } else if (event->config_result == MIRROR_CONFIG_RESULT_MATCH_DELIVERED) {
+        aeromirror_config_delivered.fetch_add(1);
+    } else if (event->config_result == MIRROR_CONFIG_RESULT_MISMATCH_DISCARDED) {
+        aeromirror_config_discarded.fetch_add(1);
+    }
+    if (event->type0_packets > previous_type0) {
+        aeromirror_last_ingress_us.store(g_get_monotonic_time());
+        aeromirror_video_ingress_generation.fetch_add(1);
+    }
+}
