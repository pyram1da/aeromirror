+}
+
+static void aeromirror_reset_recovery_candidates_locked() {
+    g_atomic_int_set(&aeromirror_recovery_push_accepted_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_sink_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_present_seen_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_present_pending_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_push_logged_epoch, 0);
+    g_atomic_int_set(&aeromirror_recovery_push_failure_logged_epoch, 0);
+    memset(aeromirror_recovery_pts, 0,
+           sizeof(aeromirror_recovery_pts));
+    aeromirror_recovery_pts_next = 0;
+    aeromirror_recovery_matched_slot = -1;
+    aeromirror_recovery_matched_pts = GST_CLOCK_TIME_NONE;
+    aeromirror_recovery_pts_delta_ms = 0;
+}
+
+static void aeromirror_reset_recovery_candidates() {
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    aeromirror_reset_recovery_candidates_locked();
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+}
+
+static gint aeromirror_signed_delta_ms(GstClockTime pts,
+                                       GstClockTime running_time) {
+    guint64 delta_ns;
+    guint64 delta_ms;
+    if (pts >= running_time) {
+        delta_ns = pts - running_time;
+        delta_ms = delta_ns / GST_MSECOND;
+        return delta_ms > G_MAXINT ? G_MAXINT : (gint) delta_ms;
+    }
+    delta_ns = running_time - pts;
+    delta_ms = delta_ns / GST_MSECOND;
+    return delta_ms > G_MAXINT ? G_MININT : -(gint) delta_ms;
+}
+
+void video_renderer_arm_recovery(unsigned int epoch,
+                                 unsigned int gap_seconds) {
+    if (!epoch || epoch > G_MAXINT) {
+        return;
+    }
+    /* Disarm the previous challenge before clearing any stage. This prevents
+     * a late sink/Present callback from repopulating an old epoch while the
+     * new challenge is being published. */
+    g_atomic_int_set(&aeromirror_recovery_epoch, 0);
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    aeromirror_reset_recovery_candidates_locked();
+    g_atomic_int_set(&aeromirror_recovery_gap_seconds,
+                     (gint) MIN(gap_seconds, (unsigned int) G_MAXINT));
+    g_atomic_int_set(&aeromirror_recovery_epoch, (gint) epoch);
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+}
+
+void video_renderer_cancel_recovery() {
+    g_atomic_int_set(&aeromirror_recovery_epoch, 0);
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    aeromirror_reset_recovery_candidates_locked();
+    g_atomic_int_set(&aeromirror_recovery_gap_seconds, 0);
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+}
+
+static GstPadProbeReturn aeromirror_recovery_sink_probe(
+        GstPad *pad, GstPadProbeInfo *info, gpointer user_data) {
+    gint selected_id = GPOINTER_TO_INT(user_data);
+    if (selected_id > 0 &&
+        g_atomic_int_get(&aeromirror_active_renderer_id) == selected_id &&
+        (GST_PAD_PROBE_INFO_TYPE(info) & GST_PAD_PROBE_TYPE_BUFFER)) {
+        g_atomic_int_inc(&aeromirror_health_sink_count);
+    }
+    gint epoch = g_atomic_int_get(&aeromirror_recovery_epoch);
+    if (!epoch || selected_id <= 0 ||
+        g_atomic_int_get(&aeromirror_active_renderer_id) != selected_id ||
+        !(GST_PAD_PROBE_INFO_TYPE(info) & GST_PAD_PROBE_TYPE_BUFFER)) {
+        return GST_PAD_PROBE_OK;
+    }
+    GstBuffer *buffer = GST_PAD_PROBE_INFO_BUFFER(info);
+    GstClockTime sink_pts = buffer ? GST_BUFFER_PTS(buffer) : GST_CLOCK_TIME_NONE;
+    gint matched_slot = -1;
+    gboolean accepted = FALSE;
+    gint pts_delta_ms = 0;
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    if (g_atomic_int_get(&aeromirror_recovery_epoch) == epoch &&
+        aeromirror_recovery_matched_slot < 0) {
+        for (guint i = 0; i < AEROMIRROR_RECOVERY_PTS_SLOTS; i++) {
+            if (aeromirror_recovery_pts[i].epoch == epoch &&
+                aeromirror_recovery_pts[i].pts == sink_pts) {
+                matched_slot = (gint) i;
+                accepted = aeromirror_recovery_pts[i].accepted;
+                pts_delta_ms =
+                    aeromirror_recovery_pts[i].pts_delta_ms;
+                aeromirror_recovery_matched_slot = matched_slot;
+                aeromirror_recovery_matched_pts = sink_pts;
+                aeromirror_recovery_pts_delta_ms = pts_delta_ms;
+                break;
+            }
+        }
+    }
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+    if (!GST_CLOCK_TIME_IS_VALID(sink_pts) || matched_slot < 0) {
+        return GST_PAD_PROBE_OK;
+    }
+    if (g_atomic_int_compare_and_exchange(
+            &aeromirror_recovery_sink_epoch, 0, epoch)) {
+        logger_protocol(logger,
+                   "AEROMIRROR_VIDEO_SINK_RECOVERED epoch=%d "
+                   "target_pts_ns=%" G_GUINT64_FORMAT " sink_pts_ns=%" G_GUINT64_FORMAT,
+                   epoch, sink_pts, sink_pts);
+    }
+    if (accepted) {
+        g_atomic_int_set(
+            &aeromirror_recovery_push_accepted_epoch, epoch);
+    }
+    return GST_PAD_PROBE_OK;
+}
+
+static void aeromirror_recovery_present(GstElement *videosink,
+                                        GstObject *device,
+                                        gpointer render_target,
+                                        gpointer user_data) {
+    gint selected_id = GPOINTER_TO_INT(user_data);
+    gint epoch = g_atomic_int_get(&aeromirror_recovery_epoch);
+    (void) videosink;
+    (void) device;
+    (void) render_target;
+    if (selected_id <= 0 ||
+        g_atomic_int_get(&aeromirror_active_renderer_id) != selected_id) {
+        return;
+    }
+    g_atomic_int_inc(&aeromirror_health_present_count);
+    if (!epoch ||
+        g_atomic_int_get(&aeromirror_recovery_sink_epoch) != epoch) {
+        return;
+    }
+    g_atomic_int_compare_and_exchange(
+        &aeromirror_recovery_present_seen_epoch, 0, epoch);
+    if (g_atomic_int_get(
+            &aeromirror_recovery_push_accepted_epoch) == epoch) {
+        g_atomic_int_compare_and_exchange(
+            &aeromirror_recovery_present_pending_epoch, 0, epoch);
+    }
+}
+
+void video_renderer_poll_recovery_present() {
+    g_mutex_lock(&aeromirror_recovery_metadata_lock);
+    gint epoch = g_atomic_int_get(
+        &aeromirror_recovery_present_pending_epoch);
+    if (!epoch || !g_atomic_int_compare_and_exchange(
+            &aeromirror_recovery_epoch, epoch, 0)) {
+        g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+        return;
+    }
+    gint gap_seconds = g_atomic_int_get(
+        &aeromirror_recovery_gap_seconds);
+    gint pts_delta_ms = aeromirror_recovery_pts_delta_ms;
+    aeromirror_reset_recovery_candidates_locked();
+    g_atomic_int_set(&aeromirror_recovery_gap_seconds, 0);
+    g_mutex_unlock(&aeromirror_recovery_metadata_lock);
+    logger_protocol(logger,
+               "AEROMIRROR_VIDEO_PRESENT_READY epoch=%d gap_seconds=%d "
+               "proof=d3d11-present pts_delta_ms=%d",
+               epoch, gap_seconds, pts_delta_ms);
+}
+
+static void aeromirror_attach_d3d11_present_proof(
+        video_renderer_t *selected, GstElement *videosink_element) {
+    if (!sync) {
+        return;
+    }
+    GstElementFactory *factory = gst_element_get_factory(videosink_element);
+    const gchar *factory_name = factory
+        ? gst_plugin_feature_get_name(GST_PLUGIN_FEATURE(factory)) : NULL;
