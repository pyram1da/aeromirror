+{
+    if (!name || name_len <= 0 || hw_addr_len <= 0) return 0;
+
+    int has_non_whitespace = 0;
+    for (int i = 0; i < name_len; i++) {
+        if ((unsigned char) name[i] > 0x20) {
+            has_non_whitespace = 1;
+            break;
+        }
+    }
+    if (!has_non_whitespace) return 0;
+
+    /* The RAOP service label is "<hex MAC>@<receiver name>". Keep one
+     * canonical receiver label for RAOP, AirPlay, and /info, bounded by the
+     * stricter RAOP limit when NoAutoRename is enabled. */
+    int maximum = DNSSD_SERVICE_LABEL_MAX_BYTES - (2 * hw_addr_len) - 1;
+    if (maximum <= 0) return 0;
+    int length = name_len < maximum ? name_len : maximum;
+
+    /* UxPlay validates the input as UTF-8 before dnssd_init. If the byte limit
+     * lands inside a multibyte code point, retreat to its leading byte. */
+    if (length < name_len) {
+        while (length > 0 &&
