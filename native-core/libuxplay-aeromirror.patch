+static gboolean aeromirror_apply_presentation_command(gpointer data) {
+    aeromirror_presentation_command_t *command =
+        (aeromirror_presentation_command_t *) data;
+    if (!command || do_shutdown.load()) return G_SOURCE_REMOVE;
+
+    if (command->kind == AEROMIRROR_PRESENTATION_FULLSCREEN) {
+        bool applied = video_renderer_set_fullscreen(command->value != 0);
+        if (!applied) {
+            aeromirror_protocol_marker(
+                "AEROMIRROR_VIDEO_FULLSCREEN requested=%u actual=0 "
+                "result=unavailable generation=0 source=ipc",
+                command->value);
+        }
+    } else if (command->kind == AEROMIRROR_PRESENTATION_SCALE) {
+        bool applied = video_renderer_set_scale(command->value);
+        aeromirror_protocol_marker(
+            "AEROMIRROR_VIDEO_SCALE permille=%u result=%s",
+            command->value, applied ? "applied" : "unavailable");
+    }
+    return G_SOURCE_REMOVE;
+}
+
+static int aeromirror_queue_presentation_command(
+        aeromirror_presentation_command_kind_t kind,
+        unsigned int value) {
+    if (do_shutdown.load()) return 0;
+
+    GMainContext *context = NULL;
+    {
+        std::lock_guard<std::mutex> guard(aeromirror_context_mutex);
+        if (aeromirror_main_context && g_loop) {
+            context = g_main_context_ref(aeromirror_main_context);
+        }
+    }
+    if (!context) return 0;
+
+    aeromirror_presentation_command_t *command =
+        g_try_new0(aeromirror_presentation_command_t, 1);
+    if (!command) {
+        g_main_context_unref(context);
+        return 0;
+    }
+    command->kind = kind;
+    command->value = value;
+
+    GSource *source = g_idle_source_new();
+    if (!source) {
+        g_free(command);
+        g_main_context_unref(context);
+        return 0;
+    }
+    g_source_set_callback(source, aeromirror_apply_presentation_command,
+                          command, g_free);
+    guint source_id = g_source_attach(source, context);
+    g_source_unref(source);
+    g_main_context_unref(context);
+    return source_id ? 1 : 0;
+}
