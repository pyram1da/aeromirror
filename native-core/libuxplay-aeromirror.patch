+
+static void aeromirror_detach_d3d11_present_proof(
+        video_renderer_t *selected) {
+    if (!selected) {
+        return;
+    }
+    selected->aeromirror_present_proof_ready = false;
+    if (selected->aeromirror_present_handler &&
+        selected->aeromirror_present_sink) {
+        g_signal_handler_disconnect(
+            selected->aeromirror_present_sink,
+            selected->aeromirror_present_handler);
+    }
+    if (selected->aeromirror_sink_probe &&
+        selected->aeromirror_present_pad) {
+        gst_pad_remove_probe(
+            selected->aeromirror_present_pad,
+            selected->aeromirror_sink_probe);
+    }
+    if (selected->aeromirror_present_pad) {
+        gst_object_unref(selected->aeromirror_present_pad);
+    }
+    if (selected->aeromirror_present_sink) {
+        gst_object_unref(selected->aeromirror_present_sink);
+    }
+    selected->aeromirror_present_pad = NULL;
+    selected->aeromirror_present_sink = NULL;
+    selected->aeromirror_present_handler = 0;
+    selected->aeromirror_sink_probe = 0;
+}
