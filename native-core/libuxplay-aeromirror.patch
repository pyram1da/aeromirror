+static bool playlist_parse_nonnegative_int(const char *text, size_t len,
+                                           int *value) {
+    if (!text || !value || len == 0) {
+        return false;
+    }
+    int parsed = 0;
+    for (size_t i = 0; i < len; i++) {
+        unsigned char current = (unsigned char) text[i];
+        if (current < '0' || current > '9' ||
+            parsed > (INT_MAX - (current - '0')) / 10) {
+            return false;
+        }
+        parsed = parsed * 10 + (current - '0');
+    }
+    *value = parsed;
+    return true;
+}
