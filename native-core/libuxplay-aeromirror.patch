+static const char *aeromirror_health_classification(
+        uint64_t ingress_delta, uint64_t input_delta, uint64_t push_delta,
+        uint64_t push_error_delta,
+        uint64_t sink_delta, uint64_t present_delta, bool suspended,
+        bool present_proof_available, bool starting, bool pipeline_reset) {
+    if (starting) return "starting";
+    if (pipeline_reset) return "pipeline-reset";
+    if (suspended) return "client-paused";
+    if (!ingress_delta) return "no-vcl";
+    if (!input_delta) return "pre-appsrc";
+    if (push_error_delta && !push_delta) return "appsrc-error";
+    if (!push_delta) return "pre-appsrc";
+    if (!present_proof_available) return "unavailable";
+    if (!sink_delta) return "decoder-stall";
+    if (!present_delta) return "present-stall";
+    return "healthy";
+}
