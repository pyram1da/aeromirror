diff --git a/aeromirror_host_protocol.h b/aeromirror_host_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..280b362bd367d588e9e520b35f733091a110d37a
--- /dev/null
+++ b/aeromirror_host_protocol.h
@@ -0,0 +1,11 @@
+#pragma once
+
+/* Private in-process protocol between the UxPlay renderer thread and the
+ * Qt-owned AeroMirror viewer window.  These values deliberately live in the
+ * WM_APP range and are never sent across a process boundary. */
+#define AEROMIRROR_WM_RENDERER_SHOW          0xB310u
+#define AEROMIRROR_WM_RENDERER_HIDE          0xB311u
+#define AEROMIRROR_WM_RENDERER_FULLSCREEN_SET 0xB312u
+
+#define AEROMIRROR_FULLSCREEN_SOURCE_COMMAND 1u
+#define AEROMIRROR_FULLSCREEN_SOURCE_INITIAL 2u
diff --git a/aeromirror_log_protocol.h b/aeromirror_log_protocol.h
new file mode 100644
index 0000000000000000000000000000000000000000..2005c4ff24266ce0812dd10e18365f5d661206de
--- /dev/null
+++ b/aeromirror_log_protocol.h
@@ -0,0 +1,74 @@
+#ifndef AEROMIRROR_LOG_PROTOCOL_H
+#define AEROMIRROR_LOG_PROTOCOL_H
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+
+#define AEROMIRROR_PROTOCOL_PREFIX "AEROMIRROR_"
+
+static inline void aeromirror_sanitize_control_bytes(char *text) {
+    if (!text) return;
+    for (char *cursor = text; *cursor; cursor++) {
+        unsigned char value = (unsigned char) *cursor;
+        if (value < 0x20 || value == 0x7f) *cursor = ' ';
+    }
+}
+
+static inline int aeromirror_ascii_equal_ignore_case(char left, char right) {
+    unsigned char lhs = (unsigned char) left;
+    unsigned char rhs = (unsigned char) right;
+    if (lhs >= 'a' && lhs <= 'z') lhs = (unsigned char) (lhs - 'a' + 'A');
+    if (rhs >= 'a' && rhs <= 'z') rhs = (unsigned char) (rhs - 'a' + 'A');
+    return lhs == rhs;
+}
+
+static inline void aeromirror_sanitize_ordinary_log(char *text) {
+    if (!text) return;
+    aeromirror_sanitize_control_bytes(text);
+
+    const size_t prefix_length = sizeof(AEROMIRROR_PROTOCOL_PREFIX) - 1;
+    for (char *candidate = text; *candidate; candidate++) {
+        size_t index = 0;
+        while (index < prefix_length && candidate[index] &&
+               aeromirror_ascii_equal_ignore_case(
+                   candidate[index], AEROMIRROR_PROTOCOL_PREFIX[index])) {
+            index++;
+        }
+        if (index == prefix_length) {
+            /* Keep diagnostics readable without leaving a control token that
+             * a case-insensitive host could interpret as protocol output. */
+            candidate[prefix_length - 1] = '-';
+            candidate += prefix_length - 1;
+        }
+    }
+}
+
+static inline int aeromirror_is_protocol_marker(const char *text) {
+    return text && strncmp(
+        text,
+        AEROMIRROR_PROTOCOL_PREFIX,
+        sizeof(AEROMIRROR_PROTOCOL_PREFIX) - 1) == 0;
+}
+
+static inline int aeromirror_ordinary_output(
+        FILE *stream, const char *format, ...) {
+    if (!stream || !format) return 0;
+
+    char line[4098] = {0};
+    va_list args;
+    va_start(args, format);
+    int body_length = vsnprintf(line, sizeof(line) - 2, format, args);
+    va_end(args);
+    if (body_length < 0) return 0;
+
+    size_t length = (size_t) body_length;
+    if (length > sizeof(line) - 3) length = sizeof(line) - 3;
+    aeromirror_sanitize_ordinary_log(line);
+    line[length++] = '\n';
+    line[length] = '\0';
+    size_t written = fwrite(line, 1, length, stream);
+    return written == length && fflush(stream) == 0;
+}
+
+#endif
