diff --git a/lib/worker_lifecycle.c b/lib/worker_lifecycle.c
new file mode 100644
index 0000000000000000000000000000000000000000..79200ca2f103a68cece36e8207b001fd12268470
--- /dev/null
+++ b/lib/worker_lifecycle.c
@@ -0,0 +1,232 @@
+#include "worker_lifecycle.h"
+
+#include <assert.h>
+#include <string.h>
+
+static int
+worker_lifecycle_default_create(thread_handle_t *thread,
+                                THREAD_RETVAL (*thread_func)(void *),
+                                void *thread_arg)
+{
+    return pthread_create(thread, NULL, thread_func, thread_arg);
+}
+
+static int
+worker_lifecycle_default_join(thread_handle_t thread, void **retval)
+{
+    return pthread_join(thread, retval);
+}
+
+static thread_handle_t
+worker_lifecycle_default_self(void)
+{
+    return pthread_self();
+}
+
+static int
+worker_lifecycle_default_equal(thread_handle_t left, thread_handle_t right)
+{
+    return pthread_equal(left, right);
+}
+
+int
+worker_lifecycle_init(worker_lifecycle_t *lifecycle)
+{
+    const worker_lifecycle_ops_t ops = {
+        worker_lifecycle_default_create,
+        worker_lifecycle_default_join,
+        worker_lifecycle_default_self,
+        worker_lifecycle_default_equal
+    };
+    return worker_lifecycle_init_with_ops(lifecycle, &ops);
+}
+
+int
+worker_lifecycle_init_with_ops(worker_lifecycle_t *lifecycle,
+                               const worker_lifecycle_ops_t *ops)
+{
+    assert(lifecycle);
+    assert(ops);
+    assert(ops->create);
+    assert(ops->join);
+    assert(ops->self);
+    assert(ops->equal);
+
+    memset(lifecycle, 0, sizeof(*lifecycle));
+    lifecycle->ops = *ops;
+    lifecycle->joined = 1;
+    if (pthread_mutex_init(&lifecycle->mutex, NULL) != 0) {
+        return -1;
+    }
+    if (pthread_cond_init(&lifecycle->cond, NULL) != 0) {
+        pthread_mutex_destroy(&lifecycle->mutex);
+        return -1;
+    }
+    return 0;
+}
+
+void
+worker_lifecycle_destroy(worker_lifecycle_t *lifecycle)
+{
+    assert(lifecycle);
+    pthread_mutex_lock(&lifecycle->mutex);
+    assert(lifecycle->joined);
+    assert(!lifecycle->joining);
+    assert(!lifecycle->join_failed);
+    pthread_mutex_unlock(&lifecycle->mutex);
+    pthread_cond_destroy(&lifecycle->cond);
+    pthread_mutex_destroy(&lifecycle->mutex);
+}
+
+void
+worker_lifecycle_lock(worker_lifecycle_t *lifecycle)
+{
+    pthread_mutex_lock(&lifecycle->mutex);
+}
+
+void
+worker_lifecycle_unlock(worker_lifecycle_t *lifecycle)
+{
+    pthread_mutex_unlock(&lifecycle->mutex);
+}
+
+int
+worker_lifecycle_can_start_locked(const worker_lifecycle_t *lifecycle)
+{
+    return lifecycle->joined && !lifecycle->running && !lifecycle->joining &&
+           !lifecycle->join_failed;
+}
+
+int
+worker_lifecycle_start_thread_locked(worker_lifecycle_t *lifecycle,
+                                     THREAD_RETVAL (*thread_func)(void *),
+                                     void *thread_arg)
+{
+    assert(lifecycle);
+    assert(thread_func);
+    if (!worker_lifecycle_can_start_locked(lifecycle)) {
+        return 0;
+    }
+
+    lifecycle->running = 1;
+    lifecycle->join_failed = 0;
+    if (lifecycle->ops.create(&lifecycle->thread, thread_func, thread_arg) != 0) {
+        lifecycle->running = 0;
+        return -1;
+    }
+    lifecycle->joined = 0;
+    return 1;
+}
+
+int
+worker_lifecycle_should_run(worker_lifecycle_t *lifecycle)
+{
+    int running;
+    worker_lifecycle_lock(lifecycle);
+    running = lifecycle->running;
+    worker_lifecycle_unlock(lifecycle);
+    return running;
+}
+
+void
+worker_lifecycle_mark_exited(worker_lifecycle_t *lifecycle)
+{
+    worker_lifecycle_lock(lifecycle);
+    lifecycle->running = 0;
+    worker_lifecycle_unlock(lifecycle);
+}
+
+int
+worker_lifecycle_is_joined(worker_lifecycle_t *lifecycle)
+{
+    int joined;
+    worker_lifecycle_lock(lifecycle);
+    joined = lifecycle->joined;
+    worker_lifecycle_unlock(lifecycle);
+    return joined;
+}
+
+int
+worker_lifecycle_is_running_or_joinable(worker_lifecycle_t *lifecycle)
+{
+    int active;
+    worker_lifecycle_lock(lifecycle);
+    active = lifecycle->running || !lifecycle->joined;
+    worker_lifecycle_unlock(lifecycle);
+    return active;
+}
+
+int
+worker_lifecycle_stop(worker_lifecycle_t *lifecycle,
+                      worker_lifecycle_locked_callback_t wake_locked,
+                      worker_lifecycle_callback_t wake_unlocked,
+                      worker_lifecycle_callback_t cleanup_unlocked,
+                      void *opaque)
+{
+    thread_handle_t thread;
+    int join_result;
+
+    assert(lifecycle);
+    worker_lifecycle_lock(lifecycle);
+    for (;;) {
+        if (lifecycle->joined) {
+            worker_lifecycle_unlock(lifecycle);
+            return WORKER_LIFECYCLE_STOP_ALREADY_JOINED;
+        }
+        if (lifecycle->join_failed) {
+            worker_lifecycle_unlock(lifecycle);
+            return WORKER_LIFECYCLE_STOP_JOIN_FAILED;
+        }
+
+        if (lifecycle->ops.equal(lifecycle->ops.self(), lifecycle->thread)) {
+            lifecycle->running = 0;
+            worker_lifecycle_unlock(lifecycle);
+            return WORKER_LIFECYCLE_STOP_SELF;
+        }
+
+        if (!lifecycle->joining) {
+            break;
+        }
+
+        while (lifecycle->joining && !lifecycle->joined) {
+            pthread_cond_wait(&lifecycle->cond, &lifecycle->mutex);
+        }
+        if (lifecycle->joined) {
+            worker_lifecycle_unlock(lifecycle);
+            return WORKER_LIFECYCLE_STOP_WAITED;
+        }
+    }
+
+    lifecycle->joining = 1;
+    lifecycle->running = 0;
+    thread = lifecycle->thread;
+    if (wake_locked) {
+        wake_locked(opaque);
+    }
+    worker_lifecycle_unlock(lifecycle);
+
+    if (wake_unlocked) {
+        wake_unlocked(opaque);
+    }
+
+    join_result = lifecycle->ops.join(thread, NULL);
+
+    if (join_result != 0) {
+        worker_lifecycle_lock(lifecycle);
+        lifecycle->joining = 0;
+        lifecycle->join_failed = 1;
+        pthread_cond_broadcast(&lifecycle->cond);
+        worker_lifecycle_unlock(lifecycle);
+        return WORKER_LIFECYCLE_STOP_JOIN_FAILED;
+    }
+
+    if (cleanup_unlocked) {
+        cleanup_unlocked(opaque);
+    }
+    worker_lifecycle_lock(lifecycle);
+    lifecycle->joined = 1;
+    lifecycle->joining = 0;
+    pthread_cond_broadcast(&lifecycle->cond);
+    worker_lifecycle_unlock(lifecycle);
+    return WORKER_LIFECYCLE_STOP_COMPLETED;
+}
diff --git a/lib/worker_lifecycle.h b/lib/worker_lifecycle.h
new file mode 100644
index 0000000000000000000000000000000000000000..721f6784b4dc41ea95fe9e904e4275416437fb3c
--- /dev/null
+++ b/lib/worker_lifecycle.h
@@ -0,0 +1,73 @@
+/*
+ * Shared lifecycle state for native worker threads.
+ *
+ * A worker that exits naturally leaves joined == 0.  The first external
+ * stopper owns pthread_join(); concurrent stoppers wait until both the join
+ * and the owner-specific resource cleanup have completed.
+ */
+
+#ifndef WORKER_LIFECYCLE_H
+#define WORKER_LIFECYCLE_H
+
+#include "threads.h"
+
+typedef int (*worker_lifecycle_create_fn)(thread_handle_t *,
+                                          THREAD_RETVAL (*)(void *), void *);
+typedef int (*worker_lifecycle_join_fn)(thread_handle_t, void **);
+typedef thread_handle_t (*worker_lifecycle_self_fn)(void);
+typedef int (*worker_lifecycle_equal_fn)(thread_handle_t, thread_handle_t);
+
+typedef struct worker_lifecycle_ops_s {
+    worker_lifecycle_create_fn create;
+    worker_lifecycle_join_fn join;
+    worker_lifecycle_self_fn self;
+    worker_lifecycle_equal_fn equal;
+} worker_lifecycle_ops_t;
+
+typedef struct worker_lifecycle_s {
+    int running;
+    int joining;
+    int joined;
+    int join_failed;
+    thread_handle_t thread;
+    mutex_handle_t mutex;
+    cond_handle_t cond;
+    worker_lifecycle_ops_t ops;
+} worker_lifecycle_t;
+
+typedef void (*worker_lifecycle_locked_callback_t)(void *opaque);
+typedef void (*worker_lifecycle_callback_t)(void *opaque);
+
+enum {
+    WORKER_LIFECYCLE_STOP_JOIN_FAILED = -1,
+    WORKER_LIFECYCLE_STOP_ALREADY_JOINED = 0,
+    WORKER_LIFECYCLE_STOP_COMPLETED = 1,
+    WORKER_LIFECYCLE_STOP_WAITED = 2,
+    WORKER_LIFECYCLE_STOP_SELF = 3
+};
+
+int worker_lifecycle_init(worker_lifecycle_t *lifecycle);
+int worker_lifecycle_init_with_ops(worker_lifecycle_t *lifecycle,
+                                   const worker_lifecycle_ops_t *ops);
+/* Destruction is externally serialized after every stop caller has returned. */
+void worker_lifecycle_destroy(worker_lifecycle_t *lifecycle);
+
+void worker_lifecycle_lock(worker_lifecycle_t *lifecycle);
+void worker_lifecycle_unlock(worker_lifecycle_t *lifecycle);
+int worker_lifecycle_can_start_locked(const worker_lifecycle_t *lifecycle);
+int worker_lifecycle_start_thread_locked(worker_lifecycle_t *lifecycle,
+                                         THREAD_RETVAL (*thread_func)(void *),
+                                         void *thread_arg);
+int worker_lifecycle_should_run(worker_lifecycle_t *lifecycle);
+void worker_lifecycle_mark_exited(worker_lifecycle_t *lifecycle);
+int worker_lifecycle_is_joined(worker_lifecycle_t *lifecycle);
+int worker_lifecycle_is_running_or_joinable(worker_lifecycle_t *lifecycle);
+
+int worker_lifecycle_stop(
+    worker_lifecycle_t *lifecycle,
+    worker_lifecycle_locked_callback_t wake_locked,
+    worker_lifecycle_callback_t wake_unlocked,
+    worker_lifecycle_callback_t cleanup_unlocked,
+    void *opaque);
+
+#endif /* WORKER_LIFECYCLE_H */
